# Q&A Generation Configuration
# Copy to .env and modify as needed (optional)

# Model directory
MODEL_DIR=models

# Device: auto, cpu, cuda, mps
DEVICE=auto

# Model quantization: q5_k_m, q4_k_m
MODEL_TYPE=q5_k_m

# Default number of questions
NUM_QUESTIONS=10

# Vector retrieval k
TOP_K=3

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# Generation
TEMPERATURE=0.7
MAX_RETRIES=2

# Validation
SIMILARITY_THRESHOLD=0.85
MIN_ANSWER_LENGTH=20
